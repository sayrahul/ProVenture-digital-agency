# ProVenture Backend Configuration
# This backend saves contact form submissions to a local JSON file
# No email service required - all Gmail dependencies removed

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Server Configuration
PORT=5000
HOST=127.0.0.1

# Data Storage
DATA_FILE=submissions.json

# CORS Settings (adjust for production)
CORS_ORIGINS=*

# Optional: Add your own custom settings below
# APP_NAME=ProVenture Contact API
# LOG_LEVEL=INFO
